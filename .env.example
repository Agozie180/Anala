# Anala Environment Variables

# Runtime mode (research = analysis only, live = pending derivatives integration)
ANALA_MODE=research

# Data directory for SQLite database and logs
ANALA_DATA_DIR=data

# Admin token for protected endpoints
ANALA_ADMIN_TOKEN=your-secure-token-here

# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta
SOLANA_WALLET_ADDRESS=

# PreStocks API
PRESTOCKS_API_URL=https://prestocks.com/api/prestocks

# LLM Provider (openai or anthropic)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional News Sources
FINNHUB_API_KEY=
NEWSAPI_KEY=

# Risk Parameters (optional overrides)
ANALA_MAX_LEVERAGE=5
ANALA_COUNCIL_QUORUM=4
