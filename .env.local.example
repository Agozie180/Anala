# Solana Configuration
# network: "devnet" (Vercel demo) or "localnet" (local validator)
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Anala Lending Program — fixed id (same on localnet + devnet). Do not change.
NEXT_PUBLIC_LENDING_PROGRAM_ID=7h6qLdbjD12HspcDc1vk8uCsf2STHGWJSkHH9FvyYNLG

# The four mints below are created by `npm run setup:devnet`, which prints the
# filled-in values (and writes them to .env.devnet). Paste them here + into Vercel.
NEXT_PUBLIC_USDC_MINT=
NEXT_PUBLIC_ANTHROPIC_MINT=
NEXT_PUBLIC_OPENAI_MINT=
NEXT_PUBLIC_SPACEX_MINT=

# See DEPLOY_DEVNET.md for the full go-live runbook.
